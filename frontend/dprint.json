{
  "$schema": "",
  "typescript": {
    "lineWidth": 120,
    "indentWidth": 2,
    "useTabs": true,
    "semiColons": "always",
    "quoteStyle": "alwaysDouble",
    "newLineKind": "lf",
    "preferSingleLine": true,
    "trailingCommas": "never",
    "overrides": [
      {
        "files": ["**/*.tsx", "**/*.jsx"],
        "lineWidth": 90
      }
    ]
  },
  "malva": {},
  "excludes": ["**/node_modules", "**/*-lock.json"],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"
  ]
}
